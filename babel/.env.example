# Copy to .env.local and fill in what you have. Never commit real keys.

# Which translation engine to use: "deepl", "anthropic", or "preview".
# "preview" needs no key but only knows the built-in demo sentences.
TRANSLATION_PROVIDER=preview

# DeepL (https://www.deepl.com/pro-api). Free-tier keys end in ":fx".
DEEPL_API_KEY=

# Anthropic (https://console.anthropic.com). ANTHROPIC_MODEL is optional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
