# Copy to .env.local (the app) and .env (the Prisma CLI). Never commit real keys.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://babel:babel@localhost:5432/babel
# Separate database for `npm run test:db`. Tests only add rows; they never wipe it.
TEST_DATABASE_URL=postgresql://babel:babel@localhost:5432/babel_test

# --- Site -------------------------------------------------------------------
# Public URL, used for Stripe return URLs and the cross-site check on billing.
APP_URL=http://localhost:3000

# --- Auth (Auth.js) -----------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google sign-in (optional). Redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Magic-link email over SMTP, e.g. smtp://user:pass@smtp.example.com:587
# Leave empty in development to print sign-in links to the console instead.
EMAIL_SERVER=
EMAIL_FROM=babel <hello@example.com>

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint, or printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# --- Translation ------------------------------------------------------------
# "deepl", "anthropic", or "preview" (no key; only knows the demo sentences).
TRANSLATION_PROVIDER=preview
DEEPL_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
