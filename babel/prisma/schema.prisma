// babel data model.
//
// Privacy: no table here stores what people write in rooms. The translation
// cache stores finished translations keyed by a hash, never linked to a user.
// UsageEvent stores counts only, never text.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Accounts (field names follow @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id               String        @id @default(cuid())
  name             String?
  email            String        @unique
  emailVerified    DateTime?
  image            String?
  /// Stripe customer (cus_...), created the first time someone upgrades.
  stripeCustomerId String?       @unique
  accounts         Account[]
  sessions         Session[]
  subscription     Subscription?
  usageEvents      UsageEvent[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

/// One paid subscription per user, mirrored from Stripe by the webhook.
/// What a user can actually do is worked out in features/billing/entitlements.ts.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String    @unique
  stripeCustomerId     String
  /// PlanId from src/config/plans.ts ("plus", "pro", "teams").
  plan                 String
  /// "monthly" or "annual".
  interval             String
  /// Seats paid for (Teams). 1 for everyone else.
  seats                Int       @default(1)
  /// Stripe status: active, trialing, past_due, unpaid, canceled, incomplete, ...
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  /// Set when a payment fails; cleared when the subscription is active again.
  paymentFailedAt      DateTime?
  /// The plan keeps working until this moment after a failed payment.
  graceEndsAt          DateTime?
  /// Creation time of the last Stripe event applied. Older events are ignored,
  /// so out-of-order webhook delivery can't roll the state back.
  stripeEventAt        DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([stripeCustomerId])
}

/// Stripe events already handled. Makes the webhook idempotent.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ---------------------------------------------------------------------------
// Translation and usage
// ---------------------------------------------------------------------------

/// Finished translations, so the same text is never translated twice.
/// `key` is a SHA-256 of provider, languages, tone and source text; the
/// source text itself is not stored.
model TranslationCache {
  key        String   @id
  text       String
  fromLang   String
  provider   String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([lastUsedAt])
}

/// One row per counted action. Counts only, never content.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "translation" (quantity 1) or "live_minutes" (quantity = minutes).
  kind      String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}
