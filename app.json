{
  "expo": {
    "name": "Payvr",
    "slug": "payvr",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "payvr",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "app.payvr.prototype",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Payvr uses Face ID to confirm every payment.",
        "NSCameraUsageDescription": "Payvr uses the camera to scan Payvr QR codes.",
        "NSBluetoothAlwaysUsageDescription": "Payvr uses Bluetooth to find phones right next to yours when you tap to pay.",
        "NSNearbyInteractionUsageDescription": "Payvr uses Nearby Interaction to check the other phone is right next to yours."
      }
    },
    "android": {
      "package": "app.payvr.prototype",
      "adaptiveIcon": {
        "backgroundColor": "#2150FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 104,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Payvr uses Face ID to confirm every payment."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Payvr uses the camera to scan Payvr QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Payvr uses your photos so you can pick a profile picture."
        }
      ],
      "expo-font",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "Payvr uses Bluetooth to find phones right next to yours when you tap to pay.",
          "neverForLocation": true
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2150FF",
          "icon": "./assets/images/android-icon-monochrome.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
