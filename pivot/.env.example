# ---- Required ----------------------------------------------------------
# Postgres (docker compose up -d gives you exactly this)
DATABASE_URL=postgresql://pivot:pivot@localhost:5432/pivot
# Public URL of the app (used in password-reset and invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Email (password resets, invites) -----------------------------------
# Leave EMAIL_SERVER empty in local dev: links are printed to the server
# console and shown on screen. That shortcut is disabled in production.
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM="PIVOT <hello@yourdomain.com>"

# ---- AI ------------------------------------------------------------------
# Optional. Without a key PIVOT uses its built-in analysis engine for
# summaries and Ask PIVOT answers. Keys are only ever read on the server.
# ANTHROPIC_API_KEY=sk-ant-...
# PIVOT_AI_PROVIDER=anthropic   # or "local" to force the built-in engine
# PIVOT_AI_MODEL=claude-opus-5-5

# ---- Billing (Stripe) ------------------------------------------------------
# Payments stay off until all three are set. Prices are recurring monthly
# Prices you create in the Stripe dashboard.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
