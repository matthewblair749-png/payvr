# ---- Required ----------------------------------------------------------
# Postgres (docker compose up -d gives you exactly this)
DATABASE_URL=postgresql://lumen:lumen@localhost:5432/lumen
# Auth.js secret: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app (used in links, e.g. lumen.app/pay/[slug])
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Email (magic links) ----------------------------------------------
# Leave EMAIL_SERVER empty in local dev: the sign-in link is printed to the
# server console and shown on the "check your email" page.
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM="lumen <hello@yourdomain.com>"

# ---- AI (brand import, research assistant) -----------------------------
# Optional. Without it, brand import uses the built-in heuristic matcher.
# ANTHROPIC_API_KEY=sk-ant-...
# LUMEN_AI_MODEL=claude-opus-5-5

# ---- Added in Phase 3 --------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...      # TEST MODE keys only
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
