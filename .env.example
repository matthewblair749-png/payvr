# ---- Required ----------------------------------------------------------
# Postgres (docker compose up -d gives you exactly this)
DATABASE_URL=postgresql://lumen:lumen@localhost:5432/lumen
# Auth.js secret: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app (used in links, e.g. lumen.app/pay/[slug])
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Email (magic links) ----------------------------------------------
# Leave EMAIL_SERVER empty in local dev: the sign-in link is printed to the
# server console and shown on the "check your email" page.
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM="lumen <hello@yourdomain.com>"

# ---- AI (brand import, research assistant) -----------------------------
# Optional. Without it, brand import uses the built-in heuristic matcher.
# ANTHROPIC_API_KEY=sk-ant-...
# LUMEN_AI_MODEL=claude-opus-5-5

# ---- Stripe (TEST MODE ONLY — live keys are refused at startup) --------
# Dashboard → Developers → API keys (toggle "Test mode"). Enable Connect first.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen` (local) or your webhook endpoint (deployed):
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional second secret if Connect events use a separate endpoint:
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Optional platform fee in basis points (100 = 1%). Default 0.
# LUMEN_PLATFORM_FEE_BPS=0
