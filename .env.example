# Copy to .env and fill in from Supabase → Project Settings → API.
# Leave empty to run the app on built-in mock data.
EXPO_PUBLIC_SUPABASE_URL=
# The anon / publishable key (safe to ship in the app; row-level security protects data).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Stripe TEST publishable key (pk_test_…) to use Stripe for Add money / Cash out.
# See docs/STRIPE.md for the server side (Edge Functions + webhook).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
