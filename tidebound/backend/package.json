{
  "name": "tidebound-backend",
  "private": true,
  "type": "module",
  "description": "Companion service for the Tidebound Roblox experience: erasure webhook, notifications, live config, support reversals, KPI events.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
