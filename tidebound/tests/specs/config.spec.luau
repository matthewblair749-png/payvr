return function(T, Loader)
	local Shared = Loader.root("src/Shared")
	local ConfigLoader = Loader.require(Shared.ConfigLoader)
	local Tbl = Loader.require(Shared.Util.Tbl)

	T.it("default config is valid and versioned", function()
		local cfg, errors = ConfigLoader.build(ConfigLoader.defaultSections(), nil)
		T.expect(#errors).toBe(0)
		T.expect(#cfg.version).toBe(8)
		T.expect(#cfg.drifters.species).toBe(20)
		T.expect(#cfg.drifters.traits).toBe(12)
		T.expect(#cfg.harbor.seasons.list).toBe(6)
	end)

	T.it("rejects overrides that would sell power, and keeps the defaults", function()
		local sections = ConfigLoader.defaultSections()
		local paid = Tbl.deepCopy(sections.catalog.harborPass.paidTrack)
		table.insert(paid, { tier = 2, silver = 500 })
		local cfg, errors = ConfigLoader.build(sections, { catalog = { harborPass = { paidTrack = paid } } })
		T.expect(#errors).toBeAtLeast(1)
		T.expect(string.find(errors[1], "paid pass", 1, true) ~= nil).toBeTruthy()
		T.expect(#cfg.catalog.harborPass.paidTrack).toBe(#sections.catalog.harborPass.paidTrack)

		local crates = Tbl.deepCopy(sections.catalog.crates)
		table.insert(crates[1].items, { id = "rod_tidesteel", rarity = "epic", cosmeticClass = "rodSkin" })
		local _, errors2 = ConfigLoader.build(sections, { catalog = { crates = crates } })
		T.expect(#errors2).toBeAtLeast(1)
	end)

	T.it("applies merge-patch overrides to tunables", function()
		local cfg = ConfigLoader.build(ConfigLoader.defaultSections(), { cycle = { daySeconds = 420 }, drifters = { pity = { epicOrBetterEvery = 20 } } })
		T.expect(cfg.cycle.daySeconds).toBe(420)
		T.expect(cfg.drifters.pity.epicOrBetterEvery).toBe(20)
		T.expect(cfg.drifters.pity.legendaryEvery).toBe(100)
	end)
end
