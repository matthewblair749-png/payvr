{
  "name": "Tidebound-dev",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/Shared",
        "Config": {
          "$path": "shared/config"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/Server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/Client"
        }
      }
    },
    "LocalizationService": {
      "TideboundStrings": {
        "$path": "src/Localization/strings.csv"
      }
    },
    "TextChatService": {
      "$properties": {
        "CreateDefaultTextChannels": false,
        "CreateDefaultCommands": false
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true,
        "Brightness": 2.6,
        "ClockTime": 14
      }
    },
    "StarterGui": {
      "$properties": {
        "ScreenOrientation": "LandscapeSensor"
      }
    }
  }
}